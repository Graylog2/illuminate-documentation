<?xml version="1.0" encoding="utf-8"?>
<CatapultSkin
  Version="6"
  SkinType="Component"
  Comment="Micro Content Component skin with Truncated view mode. This skin is used for Knowledge proxies by default, but it can also be used for FAQ and Promotion proxies."
  ComponentType="MicroContent"
  EnableResponsiveOutput="True">
  <MicroContentOptions
    ViewMode="Truncated" />
  <Stylesheet>
    <Styles>
      <Style
        Name="Item">
        <Properties>
          <Property
            Name="Color">#3561ff</Property>
          <Property
            Name="FontFamily">Arial</Property>
          <Property
            Name="PaddingBottom">0px</Property>
          <Property
            Name="PaddingTop">0px</Property>
          <Property
            Name="PaddingLeft">0px</Property>
        </Properties>
      </Style>
      <Style
        Name="Proxy Title">
        <Properties>
          <Property
            Name="Color">#000000</Property>
          <Property
            Name="FontFamily">Arial</Property>
          <Property
            Name="PaddingBottom">5px</Property>
          <Property
            Name="FontSize">20px</Property>
          <Property
            Name="PaddingLeft">0px</Property>
        </Properties>
      </Style>
      <Style
        Name="Response Link">
        <Properties>
          <Property
            Name="Color">#3561ff</Property>
          <Property
            Name="MarginBottom">1px</Property>
          <Property
            Name="MarginTop">2px</Property>
        </Properties>
      </Style>
    </Styles>
  </Stylesheet>
  <Strings />
</CatapultSkin>