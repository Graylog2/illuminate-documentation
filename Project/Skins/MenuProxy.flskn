<?xml version="1.0" encoding="utf-8"?>
<CatapultSkin
  Version="6"
  SkinType="Component"
  Comment="HTML5 Menu skin"
  ComponentType="Menu"
  EnableResponsiveOutput="True">
  <Stylesheet>
    <Styles>
      <Style
        Name="Menu Item">
        <Classes>
          <StyleClass
            Name="1st Level">
            <Properties>
              <Property
                Name="FontFamily">Arial</Property>
              <Property
                Name="Color">#000000</Property>
              <Property
                Name="FontSize">1em</Property>
            </Properties>
          </StyleClass>
          <StyleClass
            Name="2nd Level">
            <Properties>
              <Property
                Name="Color">#3561ff</Property>
              <Property
                Name="FontFamily">Arial</Property>
            </Properties>
          </StyleClass>
        </Classes>
      </Style>
      <Style
        Name="Menu">
        <Properties>
          <Property
            Name="BorderLeft">solid 2px #c2f0ff</Property>
          <Property
            Name="Color">#000000</Property>
          <Property
            Name="FontFamily">Arial</Property>
          <Property
            Name="PaddingLeft">0px</Property>
        </Properties>
      </Style>
    </Styles>
  </Stylesheet>
  <Strings />
</CatapultSkin>